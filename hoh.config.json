{
  "protocol": "paper",
  "harness": "pi",
  "providers": {
    "gateway": {
      "base_url": "https://api.example.com/v1",
      "api_key": "$MODEL_API_KEY",
      "api": "openai-completions",
      "models": "discover",
      "discover": {
        "exclude": ["image", "video", "embed", "tts", "whisper", "audio", "moderation", "rerank", "codex-auto-review"]
      },
      "model_defaults": {
        "context_window": 200000,
        "max_tokens": 32768,
        "reasoning": false
      },
      "model_overrides": {
        "gpt-5.6-sol": { "reasoning": true, "context_window": 400000 },
        "gpt-5.6-luna": { "reasoning": true, "context_window": 400000, "thinking_level_map": { "xhigh": "xhigh", "max": "max" } },
        "qwen3.8-flash-next": { "reasoning": true, "thinking_level_map": { "off": null, "minimal": "low", "high": "xhigh", "xhigh": "xhigh", "max": null } },
        "gpt-5.6-terra": { "reasoning": true, "context_window": 400000 },
        "gpt-5.5": { "reasoning": true, "context_window": 400000 },
        "gpt-5.4": { "reasoning": true, "context_window": 400000 },
        "gpt-5.4-mini": { "reasoning": true, "context_window": 400000 },
        "gpt-5.3-codex-spark": { "reasoning": true, "context_window": 400000 },
        "grok-4.20-0309-reasoning": { "reasoning": true },
        "grok-4.6": { "reasoning": true },
        "grok-4.5": { "reasoning": true },
        "grok-4.3": { "reasoning": true },
        "grok-3-mini": { "reasoning": true },
        "grok-3-mini-fast": { "reasoning": true },
        "glm-5.3": { "reasoning": true },
        "glm-5-turbo": { "reasoning": true }
      }
    }
  },
  "models": {
    "default": "gateway/gpt-5.5:high",
    "planner": "gateway/gpt-5.5:high",
    "developer": "gateway/gpt-5.5:high",
    "tester": "gateway/gpt-5.5:high"
  },
  "loops": 3,
  "artifact_dir": ".",
  "checks": [],
  "timeouts": {
    "role_min": 60,
    "check_min": 10,
    "provider_ms": 3600000,
    "output_idle_ms": 300000,
    "websocket_connect_ms": 15000
  },
  "retry": {
    "enabled": true,
    "max_retries": 3,
    "base_delay_ms": 2000,
    "max_delay_ms": 60000
  },
  "pi": {}
}
