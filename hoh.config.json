{
  "protocol": "paper",
  "harness": "pi",
  "providers": {
    "spbros": {
      "base_url": "https://ai-api.spbros.com/v1",
      "api_key": "$SPBROS_API_KEY",
      "api": "openai-completions",
      "models": "discover",
      "discover": {
        "exclude": ["image", "video", "embed", "tts", "whisper", "audio", "moderation", "rerank", "codex-auto-review"]
      },
      "model_defaults": {
        "context_window": 200000,
        "max_tokens": 32768,
        "reasoning": false
      },
      "model_overrides": {
        "gpt-5.6-sol": { "reasoning": true, "context_window": 400000 },
        "gpt-5.6-luna": { "reasoning": true, "context_window": 400000 },
        "gpt-5.6-terra": { "reasoning": true, "context_window": 400000 },
        "gpt-5.5": { "reasoning": true, "context_window": 400000 },
        "gpt-5.4": { "reasoning": true, "context_window": 400000 },
        "gpt-5.4-mini": { "reasoning": true, "context_window": 400000 },
        "gpt-5.3-codex-spark": { "reasoning": true, "context_window": 400000 },
        "grok-4.20-0309-reasoning": { "reasoning": true },
        "grok-4.6": { "reasoning": true },
        "grok-4.5": { "reasoning": true },
        "grok-4.3": { "reasoning": true },
        "grok-3-mini": { "reasoning": true },
        "grok-3-mini-fast": { "reasoning": true },
        "glm-5.3": { "reasoning": true },
        "glm-5-turbo": { "reasoning": true }
      }
    }
  },
  "models": {
    "default": "spbros/gpt-5.5:high",
    "planner": "spbros/gpt-5.5:high",
    "developer": "spbros/gpt-5.5:high",
    "tester": "spbros/gpt-5.5:high"
  },
  "loops": 3,
  "artifact_dir": ".",
  "checks": [],
  "timeouts": {
    "role_min": 60,
    "check_min": 10
  },
  "pi": {}
}
